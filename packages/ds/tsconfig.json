{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["react"],
    "typeRoots": ["../../node_modules/@types"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
